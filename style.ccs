body {
        font-family: Arial, sans-serif;
    background-image: url(https://i.pinimg.com/1200x/79/c4/6f/79c46f623da2851f3e29434c114f475f.jpg);
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    background-repeat: no-repeat;
    color: rgb(0, 0, 0);
    }
    h1 {
        color: #000000;
    }
    ul {
        list-style: none;
        padding-left: 1.4rem;
        margin: 0;
    }
    .mensaje-lista {
        max-width: 760px;
        margin: 30px auto;
        padding: 0;
    }
    .mensaje-lista li {
        position: relative;
        margin-bottom: 1.4rem;
        padding: 1.4rem 1.8rem;
        border-radius: 1.6rem;
        background: rgba(255, 255, 255, 0.85);
        box-shadow: 0 18px 50px rgba(20, 20, 20, 0.12);
        font-family: 'Palatino Linotype', 'Book Antiqua', Palatino, serif;
        font-size: 26px;
        line-height: 1.75;
        color: #222222;
        letter-spacing: 0.02em;
    }
    .mensaje-lista li::before {
        content: '✧';
        position: absolute;
        left: 1rem;
        top: 1rem;
        color: #9b59b6;
        font-size: 1.2rem;
    }

    button {
        background-color: #348fe3;
        border: none;
        color: rgb(255, 255, 255);
        padding: 15px 32px;
        text-align: center;
        text-decoration: none;
        display: inline-block;
        font-size: 16px;
        margin: 4px 2px;
        cursor: pointer;
    }
    
    .layout-principal {
        display: flex;
        gap: 20px;
        align-items: flex-start;
    }
    
    .columna-info {
        flex: 1;
    }
    
    .columna-video {
        flex: 1;
    }
    
    .columna-video video {
        width: 100%;
        max-width: 560px;
        height: auto;
        aspect-ratio: 16 / 9;
        border-radius: 15px;
        border: none;
    }

    .mensaje-scroll {
        animation: scrollDown 3s ease-in-out;
        font-size: 24px;
        color: #000000;
    }

    @keyframes scrollDown {
        0% {
            opacity: 0;
            transform: translateY(-50px);
        }
        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }

      
